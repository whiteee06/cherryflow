# ==============================================================================
# CHERRYFLOW OS - ENVIRONMENT VARIABLES CONFIGURATION
# ==============================================================================
# Copy this file to `.env` for local development or set these variables
# in Vercel / Supabase / Cloud Run secrets manager for Staging and Production.

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION CONFIGURATION
# ------------------------------------------------------------------------------
NODE_ENV="development" # Options: development | staging | production
PORT=3000
APP_NAME="CherryFlow OS"
APP_URL="http://localhost:3000" # Production example: https://cherryflow.app

# ------------------------------------------------------------------------------
# 2. GOOGLE GEMINI AI API (SERVER-SIDE ONLY)
# ------------------------------------------------------------------------------
# REQUIRED for AI Copilot, Outreach Generator, Task Breakdown, Note Summarizer,
# and AI Chat Streaming.
# NEVER expose this key in client-side code (VITE_ prefix is intentionally omitted).
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# ------------------------------------------------------------------------------
# 3. SUPABASE DATABASE & AUTHENTICATION (PUBLIC CLIENT KEYS)
# ------------------------------------------------------------------------------
# Safe for client-side inclusion (prefixed with VITE_).
# CherryFlow falls back seamlessly to local mock state if credentials are empty.
VITE_SUPABASE_URL="https://vedblbrrjxytdmkylzwf.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InZlZGJsYnJyanh5dGRta3lsendmIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTIwNTk1NjUsImV4cCI6MjEwNzYzNTU2NX0.aby6UCzNBv1okhgvgUEPoUbGV46aU8MTbUTrdp_zbCA"

# SUPABASE SERVICE ROLE KEY (SERVER-SIDE / CI/CD MIGRATIONS ONLY)
# Never expose to browser. Used for admin workflows and automated database migrations.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key"

# ------------------------------------------------------------------------------
# 4. SECURITY & AUTHENTICATION SECRETS
# ------------------------------------------------------------------------------
JWT_SECRET="super-secret-jwt-signing-key-minimum-32-chars-long"
ENCRYPTION_KEY="32-byte-hex-encryption-key-for-sensitive-vault-data"
ALLOWED_ORIGINS="http://localhost:3000,https://cherryflow.vercel.app,https://cherryflow.app"

# ------------------------------------------------------------------------------
# 5. MONITORING, LOGGING & ERROR TRACKING (OPTIONAL)
# ------------------------------------------------------------------------------
SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"
ENABLE_METRICS_LOGGING="true"
LOG_LEVEL="info" # Options: debug | info | warn | error

# ------------------------------------------------------------------------------
# 6. RATE LIMITING & PROTECTION
# ------------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX_REQUESTS=300 # max requests per IP in window
